# ============================================================
# Fischer — Environment Configuration
# Copy to .env.local and fill in your values.
# ============================================================

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: model for manual audits (default claude-opus-5-5)
# FISCHER_MODEL=claude-opus-5-5

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Upstash Redis (required for rate limiting) ---
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=Axxxx

# --- Google Service Account (required for GA4 integration) ---
# Create a service account in Google Cloud Console with GA4 Data API access.
# Grant it "Viewer" role on each client's GA4 property.
# Paste the full JSON key as a single-line string.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# --- Google PageSpeed Insights (optional but recommended) ---
# Get a free API key from Google Cloud Console → APIs & Services → Credentials.
# 25,000 queries/day free limit.
GOOGLE_PAGESPEED_API_KEY=AIza...

# --- Vercel Cron (required: monthly snapshots, Clarity history, scheduled re-audits, guardrails) ---
CRON_SECRET=your-random-secret-for-cron-auth

# --- Models ---
# Manual audits & baselines use FISCHER_MODEL (default claude-opus-5-5);
# scheduled monthly re-audits use FISCHER_SCHEDULED_MODEL (default claude-sonnet-5-5).
# FISCHER_SCHEDULED_MODEL=claude-sonnet-5-5

# --- Security (required) ---
# Encrypts stored credentials (Clarity tokens, Google sign-ins). openssl rand -base64 32
FISCHER_ENCRYPTION_KEY=

# --- One-click Google connection (recommended) ---
# Google Cloud → OAuth client (Web), redirect URI: {FISCHER_PUBLIC_URL}/api/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Google Ads spend (optional): developer token from the Ads API Center
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_API_VERSION=v21

# --- Report emails (optional) ---
# Resend API key; set the From address (verified domain) in Admin → Branding
# RESEND_API_KEY=

# --- Alerts (optional) ---
# Slack / Teams / Google Chat incoming webhook (any URL accepting {"text": "..."})
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Also post server errors to the webhook:
# ERROR_WEBHOOK=true

# --- App URL (used for report share links and PDF rendering) ---
# FISCHER_PUBLIC_URL=https://fischer.algorithm.agency

# --- Scheduling ---
# Vercel Pro only: queue audits for the per-minute worker cron (see README → Hosting).
# FISCHER_BACKGROUND_WORKER=true
# Days between automatic re-audits of each tracked page (default 30)
# FISCHER_REAUDIT_DAYS=30

# --- Local development only ---
# Use a locally installed Chrome/Chromium instead of the serverless build:
# CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Allow auditing localhost / private IPs (never set this in production):
# FISCHER_ALLOW_PRIVATE_URLS=true

# ============================================================
# PER-CLIENT CONFIGURATION (stored in the clients table, not here):
# - GA4 Property ID → clients.ga4_property_id
# - Clarity Project ID → clients.clarity_project_id
# - Clarity API Token → clients.clarity_api_token
# - GA4 conversion event → clients.ga4_conversion_event (optional)
#
# These are configured on the Clients screen (or /api/clients), not env vars,
# because each client has different GA4/Clarity credentials.
# ============================================================
